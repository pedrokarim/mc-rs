            "as": "player"
          },
          {
            "type": "close"
          }
        ]
      },
      {
        "id": "biome",
        "text": "§7▶ Infos biome",
        "onClick": [
          {
            "type": "command",
            "command": "biome",
            "as": "player"
          },
          {
            "type": "close"
          }
        ]
      },
      {
        "id": "showcase",
        "text": "§6▶ §lUI Showcase",
        "icon": {
          "path": "textures/items/map_filled"
        },
