      {
        "id": "spawn",
        "text": "§a▶ Téléporter au spawn",
        "icon": {
          "path": "textures/items/compass_item"
        },
        "onClick": [
          {
            "type": "command",
            "command": "tp {mcrs.spawn}",
            "as": "player"
          },
          {
            "type": "close"
          }
        ]
      },
      {
        "id": "creative",
        "text": "§b▶ Mode Créatif",
        "icon": {
          "path": "textures/blocks/grass_side_carried"
        },
        "onClick": [
          {
            "type": "command",
            "command": "gamemode creative",
            "as": "player"
          },
          {
            "type": "close"
          }
        ]
      },
      {
        "id": "survival",
        "text": "§e▶ Mode Survie",
        "onClick": [
          {
            "type": "command",
            "command": "gamemode survival",
            "as": "player"
          },
          {
            "type": "close"
          }
        ]
      },
      {
        "id": "day",
        "text": "§d▶ Régler sur Jour",
        "icon": {
          "path": "textures/items/clock_item"
        },
        "onClick": [
          {
            "type": "command",
